{
  "name": "clink-sdk",
  "version": "0.1.1",
  "description": "Stellar USDC payment infrastructure for Africa",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "example": "ts-node examples/manual-demo.ts",
    "verify": "ts-node examples/verify-payment.ts"
  },
  "keywords": [
    "stellar",
    "usdc",
    "payments",
    "africa",
    "blockchain"
  ],
  "author": "Okiemute",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "axios": "^1.15.1",
    "follow-redirects": "^1.15.12"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.0.1",
    "axios": "^1.15.1",
    "dotenv": "^17.4.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
